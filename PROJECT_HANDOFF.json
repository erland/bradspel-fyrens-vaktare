{
  "project": "Fyrens väktare",
  "handoff_version": "v0.8.8",
  "recommended_base_zip": "fyrens-vaktare-v0.8.8-repo-cleanup.zip",
  "ruleset": "REGLERV4-STARTBALANS",
  "repository_policy": {
    "source_directories": [
      "data",
      "docs",
      "scripts",
      "assets",
      "templates",
      ".github"
    ],
    "generated_directories_not_versioned": [
      "output",
      "release",
      "dist",
      "build"
    ],
    "official_release_location": "GitHub Release assets"
  },
  "current_balance": {
    "darkness": {
      "2p": 10,
      "3p": 10,
      "4p": 10
    },
    "base_food": {
      "2p": 6,
      "3p": 4,
      "4p": 4
    },
    "build_costs": {
      "Grund": {
        "sten": 3
      },
      "Torn": {
        "trä": 3,
        "sten": 2
      },
      "Ljuskärna": {
        "kristall": 2
      }
    }
  },
  "board_layout": [
    [
      "Skog",
      "Skog",
      "Ruin",
      "Berg",
      "Grotta"
    ],
    [
      "Bas",
      "Stig",
      "Fyrplats",
      "Stig",
      "Grotta"
    ],
    [
      "Stig",
      "Äng",
      "Stig",
      "Berg",
      "Stig"
    ],
    [
      "Äng",
      "Ruin",
      "Äng",
      "Stig",
      "Skog"
    ]
  ],
  "important_files": {
    "handoff": "docs/NEW_CHAT_HANDOFF.md",
    "release_policy": "docs/release-policy.md",
    "rules": "data/rules.yaml",
    "board": "data/board.yaml",
    "cards": "data/cards.yaml",
    "reference_card": "data/reference-card.yaml",
    "style": "data/visual-style.yaml",
    "ink_friendly_style": "data/ink-friendly-style.yaml",
    "renderer": "scripts/render_styled_printables.py",
    "ink_friendly_transform": "scripts/apply_ink_friendly_reference_and_board.py",
    "rulebook_pdf_builder": "scripts/build_rulebook_pdf.py",
    "print_package_builder": "scripts/build_print_and_play.py",
    "ci_validate": "scripts/ci_validate_project.py",
    "ci_preview": "scripts/ci_build_print_preview.py",
    "ci_release": "scripts/ci_package_release.py",
    "github_actions_doc": "docs/github-actions-release-workflow.md"
  },
  "local_commands": {
    "validate": "python scripts/ci_validate_project.py .",
    "build_print_and_play": "python scripts/build_print_and_play.py --output-dir dist/print-and-play --release-name local",
    "build_preview": "python scripts/ci_build_print_preview.py --output-dir dist/preview --release-name local-preview",
    "package_release": "python scripts/ci_package_release.py --output-dir dist/release --release-name vX.Y.Z"
  },
  "notes": [
    "Från v0.8.8 är release/ och output/ inte längre projektkällor.",
    "GitHub Actions och lokala script bygger printmaterial från källorna.",
    "Käll-SVG i assets/ behålls; genererade SVG/PDF byggs vid behov."
  ]
}